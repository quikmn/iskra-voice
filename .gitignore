# Build output
bin/
obj/
dist/
build/
release/
publish/
*.user
.vs/
.vscode/*
!.vscode/extensions.json

# Node
node_modules/

# Local tools and dev data (downloaded by scripts/, created by dev.ps1)
.tools/
.dev/

# Playwright
test-results/
playwright-report/
client/e2e/screenshots/

# Local-only notes
design/

# Secrets never belong here
.env
*.pfx
*.pem
relay.json

