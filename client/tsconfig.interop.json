{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.interop.tsbuildinfo",
    "types": ["node"],
    // Gallery bots (bots/gallery) import the bot SDK by its npm name.
    "paths": { "iskra-bots": ["../bots/sdk/src/index.ts"] }
  },
  "include": ["interop", "e2e", "playwright.config.ts"],
  // Imports the desktop app's tunnel (desktop/src/p2p), whose packages only desktop/ has; vitest still runs it.
  "exclude": ["interop/p2p.test.ts", "interop/p2p-sidecar.test.ts"]
}
