    "libsodium-wrappers-sumo": "^0.8.4",
    "livekit-client": "2.22.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "0.1.3",
    "zustand": "^5.0.15",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
