# Framed only by the app itself: with several accounts signed in, each runs in a same-origin frame of the top page.
/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), camera=(self), display-capture=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/service-worker.js
  Cache-Control: no-cache

/push-sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# The profile page editor's preview is framed by the app itself.
/page-preview.html
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self'

# Built-in activities are framed by the app itself (sandboxed; each has its own no-network policy).
/activities/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self'
  Cache-Control: no-cache

# Digital Asset Links for the Android app (Trusted Web Activity).
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: max-age=3600

# Universal Links for the iPhone/iPad app (mobile/ios). No extension, so the type must be set here.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: max-age=3600

# Security contact (RFC 9116); the same file is on iskra.foo.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: max-age=3600
