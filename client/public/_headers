/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), camera=(self), display-capture=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/service-worker.js
  Cache-Control: no-cache

/push-sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# The profile page editor's preview is framed by the app itself.
/page-preview.html
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self'

# Digital Asset Links for the Android app (Trusted Web Activity).
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: max-age=3600

# Universal Links for the iPhone/iPad app (mobile/ios). No extension, so the type must be set here.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: max-age=3600

# Security contact (RFC 9116); the same file is on iskra.foo.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: max-age=3600

# The live-captions model (deploy.yml puts it here; scripts/get-models.mjs). The desktop and phone apps fetch it from
# app://, capacitor:// and http://localhost pages, so any origin may read it; paths carry the model version.
/models/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
