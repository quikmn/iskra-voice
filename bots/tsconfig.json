{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    // The SDK reuses the web client's core (crypto, identity, connection); its libsodium import resolves here.
    "paths": { "libsodium-wrappers-sumo": ["./node_modules/@types/libsodium-wrappers-sumo"] }
  },
  "include": ["sdk/src", "examples"]
}
