{
  "name": "iskra-bot-examples",
  "private": true,
  "version": "0.1.0",
  "description": "Iskra's bot SDK (sdk/, published to npm as iskra-bots) and example bots.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:sdk": "node sdk/build-package.mjs",
    "pack:sdk": "node sdk/build-package.mjs && npm pack ./sdk --dry-run",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs && node --test \"dist/test/*.test.js\"",
    "bridge": "node build.mjs && node dist/cli.js bridge",
    "dice": "node build.mjs && node dist/examples/dice.js",
    "planner": "node build.mjs && node dist/examples/planner.js",
    "jukebox": "node build.mjs && node dist/examples/jukebox.js",
    "music": "node build.mjs && node dist/examples/music.js"
  },
  "dependencies": {
    "@livekit/rtc-node": "1.1.0",
    "@wasm-audio-decoders/flac": "0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "libsodium-wrappers-sumo": "^0.8.4",
    "mpg123-decoder": "1.0.3",
    "ogg-opus-decoder": "1.7.5"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "typescript": "~7.0.2"
  }
}
