{
  "name": "iskra-bots",
  "private": true,
  "version": "0.1.0",
  "description": "A small SDK for Iskra bots, plus examples.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "dice": "node build.mjs && node dist/examples/dice.js",
    "planner": "node build.mjs && node dist/examples/planner.js"
  },
  "dependencies": {
    "@livekit/rtc-node": "1.1.0",
    "@wasm-audio-decoders/flac": "0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "libsodium-wrappers-sumo": "^0.8.4",
    "mpg123-decoder": "1.0.3",
    "ogg-opus-decoder": "1.7.5"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.2"
  }
}
