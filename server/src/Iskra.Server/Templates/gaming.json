{
  "name": "Gaming group",
  "description": "Chat, clips and finding a group, plus voice channels for squads and raids.",
  "categories": [
    {
      "name": "Text channels",
      "channels": [
        { "name": "general" },
        { "name": "clips" },
        { "name": "looking-for-group" }
      ]
    },
    {
      "name": "Voice",
      "channels": [
        { "name": "Lobby", "kind": "voice" },
        { "name": "Squad 1", "kind": "voice", "userLimit": 5 },
        { "name": "Squad 2", "kind": "voice", "userLimit": 5 },
        { "name": "Raid", "kind": "voice", "userLimit": 10 },
        { "name": "AFK", "kind": "voice" }
      ]
    }
  ],
  "roles": [
    { "name": "Moderator", "color": "#3fa66b", "hoist": true, "permissions": ["manageMessages", "timeoutMembers", "kickMembers", "muteMembers", "moveMembers", "viewAuditLog"] },
    { "name": "Raid lead", "color": "#e8a33d", "icon": "⚔️", "mentionable": true, "permissions": ["moveMembers", "muteMembers"] }
  ],
  "builtinRoles": {
    "owner": { "color": "#c27ce0" },
    "admin": { "color": "#e5534b" }
  },
  "afk": { "channel": "AFK", "minutes": 30, "canTalk": ["owner", "admin"] },
  "rules": {
    "text": "1. Be good to each other. Banter is fine, harassment isn't.\n2. No cheats, hacks or account selling.\n3. Keep spoilers and NSFW out of shared channels.\n4. Post clips in #clips and find a group in #looking-for-group.",
    "welcome": "Welcome! Say hi in #general and jump into the Lobby when you're ready to play."
  }
}
