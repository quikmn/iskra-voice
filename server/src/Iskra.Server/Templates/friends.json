{
  "version": 2,
  "name": "Friends hangout",
  "description": "A relaxed place for chatting, photos and plans, with a couple of voice channels to hang out in.",
  "categories": [
    {
      "name": "Text channels",
      "channels": [
        { "name": "general" },
        { "name": "photos" },
        { "name": "memes", "kind": "media" },
        {
          "name": "plans", "kind": "forum",
          "tags": [{ "name": "Trip", "emoji": "🧳" }, { "name": "Food", "emoji": "🍕" }, { "name": "Games", "emoji": "🎮" }, { "name": "Movie", "emoji": "🎬" }]
        }
      ]
    },
    {
      "name": "Voice",
      "channels": [
        { "name": "Hangout", "kind": "voice" },
        { "name": "Quiet corner", "kind": "voice", "userLimit": 4 },
        { "name": "Movie night", "kind": "voice" },
        { "name": "AFK", "kind": "voice" }
      ]
    }
  ],
  "roles": [
    { "name": "Moderator", "color": "#3fa66b", "hoist": true, "permissions": ["manageMessages", "timeoutMembers", "kickMembers", "muteMembers", "moveMembers", "viewAuditLog", "prioritySpeaker"] }
  ],
  "builtinRoles": {
    "owner": { "color": "#c27ce0" },
    "admin": { "color": "#e5534b" },
    "member": { "abilities": ["invite", "events", "pin", "uploadSounds"] }
  },
  "afk": { "channel": "AFK", "minutes": 30, "canTalk": ["owner", "admin"] },
  "rules": {
    "text": "1. Be kind. We're all friends here.\n2. Ask before sharing someone else's photos.\n3. Keep it legal and keep it fun.",
    "welcome": "Welcome! Pull up a chair in #general."
  },
  "settings": {
    "builtinBots": ["polls", "reminders"]
  }
}
