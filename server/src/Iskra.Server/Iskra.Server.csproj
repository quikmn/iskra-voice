<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iskra-server</AssemblyName>
    <RootNamespace>Iskra.Server</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Release builds pass -p:Version=<app version> (desktop/scripts/prepare-server.mjs); this marks everything else. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iskra.Server.Tests" />
  </ItemGroup>

  <!-- The live-captions model's pins, shared with the app (one source of truth; CaptionModelTests checks it). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\client\src\state\captions\model.json" LogicalName="captions-model.json" />
    <!-- Message translation's model pins, the same way (TranslateModelTests checks it). -->
    <EmbeddedResource Include="..\..\..\client\src\state\translate\models.json" LogicalName="translate-models.json" />
    <!-- The activity SDK, put in front of server-added activities' HTML (the built-ins bundle the same file). -->
    <EmbeddedResource Include="..\..\..\protocol\activity-sdk.js" LogicalName="activity-sdk.js" />
  </ItemGroup>

  <!-- Starter templates for new servers (the Template setting; docs/hosting.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\*.json" LogicalName="templates.%(Filename).json" />
  </ItemGroup>

  <!-- Sigstore's public-good trusted root, for verifying release attestations offline (Updates/Attestations.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="Updates\sigstore-trusted-root.json" LogicalName="sigstore-trusted-root.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Sigstore" Version="1.1.1" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
