  ],
  "roles": [
    { "name": "Moderator", "color": "#3fa66b", "hoist": true, "permissions": ["manageMessages", "timeoutMembers", "kickMembers", "muteMembers", "moveMembers", "viewAuditLog", "prioritySpeaker"] }
  ],
  "builtinRoles": {
    // Testers join as Trusted: everyday powers plus moving people (Split into teams), but no @everyone.
    "trusted": { "color": "#4f9cf9", "abilities": ["invite", "events", "whisper", "pin", "uploadSounds"], "permissions": ["moveMembers"] }
  },
  "rules": {
    "required": true,
    "welcome": "Welcome to Iskra Review! Thanks for helping us test. Please read these five rules, then start in #welcome.",
    "text": "1. **Be kind.** Everyone here is testing, often in their second language. Be patient and friendly.\n2. **This is a test server.** Things can break, and messages and channels may be reset. Don't keep anything important here.\n3. **No personal data.** Don't post phone numbers, addresses, passwords or anything private, here or in screenshots.\n4. **Keep it clean.** No hate, harassment, spam or adult content. The community guidelines apply: https://iskra.foo/terms#guidelines\n5. **Report bugs in the app.** Tap your name at the bottom of the channel list, then Report a bug."
  },
  "afk": { "channel": "AFK", "minutes": 30, "canTalk": ["owner", "admin"] },
  "settings": {
    "notifyDefault": "mentions",
    "builtinBots": ["dice", "polls", "reminders"],
    "translation": true
  }
