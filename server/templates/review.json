        { "name": "Lounge 1", "kind": "voice", "topic": "Talk. Try whisper: hold the whisper button to talk only to your list (Settings → Voice & audio)." },
        { "name": "Lounge 2", "kind": "voice", "topic": "Talk. Try whispering to another voice channel, or open a whiteboard and draw together." },
        { "name": "Lounge 3", "kind": "voice", "topic": "Talk. Try your camera, and noise suppression in Settings → Voice & audio." },
        { "name": "Duo", "kind": "voice", "userLimit": 2, "topic": "Room for 2. A third person sees it's full." },
        { "name": "Music lounge", "kind": "voice", "hifi": true, "topic": "Hi-fi audio for music: turn it on in Settings → Voice & audio." },
        { "name": "Watch party", "kind": "voice", "topic": "Tap Watch together in the call bar and paste a YouTube link. Everyone sees the same moment." },
        { "name": "AFK", "kind": "voice", "topic": "Quiet room: people idle in voice for 30 minutes are moved here." }
      ]
