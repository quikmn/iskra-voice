{
  "name": "iskra-mobile",
  "private": true,
  "description": "Iskra for phones: one Capacitor shell around the built web client (client/dist), for iOS and Android. See README.md.",
  "scripts": {
    "sync": "cap sync",
    "android": "pwsh -NoProfile -File scripts/build-android.ps1",
    "icons": "python scripts/icons.py"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "google-auth-library": "11.1.0",
    "jose": "6.2.12",
    "typescript": "6.0.3"
  }
}
